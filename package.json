{
  "name": "javabuddy",
  "version": "1.0.0",
  "description": "JavaBuddy: Learn Java Like You're 3 Years Old - Interactive learning application",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@vercel/node": "^5.1.8",
    "typescript": "^5.7.3"
  },
  "keywords": ["java", "learning", "education", "monaco-editor", "react", "express"],
  "author": "JavaBuddy Team",
  "license": "MIT"
}
