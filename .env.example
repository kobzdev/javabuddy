# ==============================================================
# JavaBuddy Environment Variables Configuration
# ==============================================================

# Backend Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --------------------------------------------------------------
# Java Execution Provider (Judge0 CE / RapidAPI / Local Runner)
# --------------------------------------------------------------
# Choose one of: judge0_ce, judge0_rapidapi, local, unconfigured
JAVA_EXECUTION_PROVIDER=unconfigured

# If using self-hosted Judge0 CE:
# JUDGE0_CE_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=your_judge0_auth_token_here

# If using RapidAPI Judge0:
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Java Language ID in Judge0 (62 is OpenJDK 13/17, or 91 for JDK 17 depending on deployment)
JUDGE0_JAVA_LANG_ID=62

# Rate limiting for code execution (submissions per IP per minute)
EXECUTION_RATE_LIMIT_PER_MINUTE=15

# Execution limits
MAX_SOURCE_CODE_BYTES=65536
MAX_STDIN_BYTES=4096
EXECUTION_TIMEOUT_MS=15000

# --------------------------------------------------------------
# Supabase Database & Auth (Optional for guest-mode, required for cloud sync)
# --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend public variables (Vite requires VITE_ prefix for client-side access)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --------------------------------------------------------------
# AI Kindergarten Tutor (Optional - Built-in fallback available offline)
# --------------------------------------------------------------
# Optional external AI provider: gemini or disabled
AI_PROVIDER=disabled
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-2.0-flash
